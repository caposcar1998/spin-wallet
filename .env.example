# API propia (route handlers de esta app) — es a donde pegan apiGet/apiPost
USERS_API_BASE_URL=http://localhost:3000/api

# Upstream mockeado — a donde los route handlers proxifican
# En docker-compose se sobreescribe a http://wiremock:8080
MOCK_API_URL=http://localhost:8080

# Caos en POST /api/user/:id/movements (errores aleatorios del comprobante)
# false = todas las transacciones proxifican a WireMock (lo usa el e2e)
API_CHAOS=true

# true = getUsers devuelve [] (login muestra "Usuario no registrado")
FAKE_ERROR_LOGIN=false
